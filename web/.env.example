# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase.
# Nunca subas .env.local al repositorio.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor: se usa únicamente para enviar invitaciones (API de administración de Auth).
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL pública de la app (para enlaces de invitación y recuperación).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pruebas de base de datos: Postgres local donde se crean bases temporales.
TEST_PG_URL=postgres://localhost:5432/postgres
